[Unit]
Description=Portal Verdade Ceara internal management system
After=network.target postgresql.service
Requires=postgresql.service

[Service]
Type=simple
User=portalverdadeceara
Group=portalverdadeceara
WorkingDirectory=/var/www/apps/portalverdadeceara/current
EnvironmentFile=/var/www/apps/portalverdadeceara/shared/.env
ExecStart=/var/www/apps/portalverdadeceara/venv/bin/gunicorn portal.wsgi:application --workers 3 --threads 2 --bind 127.0.0.1:8070 --timeout 60 --graceful-timeout 30 --max-requests 1500 --max-requests-jitter 150 --access-logfile /var/www/apps/portalverdadeceara/shared/logs/access.log --error-logfile /var/www/apps/portalverdadeceara/shared/logs/error.log --capture-output
Restart=on-failure
RestartSec=5
TimeoutStopSec=45
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/www/apps/portalverdadeceara/shared

[Install]
WantedBy=multi-user.target
